# Snapshots are compared byte for byte; keep them LF on every platform.
tests/snapshots/*.txt text eol=lf
# Fixtures are shared with the Python tests; the same bytes everywhere.
tests/fixtures/*.csv text eol=lf
tests/fixtures/*.json text eol=lf
# The databases of every earlier schema are loaded as SQL by tests/storage.
tests/fixtures/sqlite/*.sql text eol=lf
# The bundle spec's worked example is hashed by its drift test.
docs/bundle-spec.md text eol=lf
# Conformance fixtures and the matrix doc generated from them are compared
# byte for byte too.
tests/conformance/fixtures/**/*.json text eol=lf
docs/exchange-feature-matrix.md text eol=lf
# The segment spec's worked example is decoded and hashed by its drift test.
docs/segment-spec.md text eol=lf
# The parity matrix and its generated ledger and view are read and compared
# byte for byte by tests/parity.
docs/parity/* text eol=lf
